{
  "info": {
    "_postman_id": "42b63d87-5c5f-5210-8029-cc0baceb83ab",
    "name": "Medfold API",
    "description": "Every endpoint of the Medfold REST API, in the order you'd use them. Run the whole collection: it registers a fresh account, uploads a synthetic report, waits for processing, exercises results, editing, search and export, and finally deletes the account.\n\nSet `baseUrl` in the environment. When running with Newman, pass `--working-dir` pointing at the repository root so the upload finds `tests/fixtures/`.\n\nDocs: docs/api/README.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "postman-demo-password"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "labResultId",
      "value": ""
    },
    {
      "key": "testKey",
      "value": ""
    },
    {
      "key": "pollsLeft",
      "value": "30"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Backend, database, schema version, AI service availability and whether this instance processes documents. Public.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('backend is up', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and starts a session. A unique email is generated on every run. The refresh token arrives as an HttpOnly cookie (Postman keeps it in its cookie jar).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Postman Demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.test('returns an access token', () => pm.expect(body.accessToken).to.be.a('string'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `postman-${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in. 401 for a wrong password; 429 with Retry-After after 5 failures for one account (or 30 from one address) within 15 minutes.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "The account behind the access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is me', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the refresh cookie and returns a new access token. Reusing an old refresh token revokes every session of the user.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload a document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "description": "Uploads one PDF, JPG or PNG (max 10 MB). The type is checked from the file's bytes. 409 for a file you already uploaded, 413 too large, 415 unsupported. Processing starts in the background.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "tests/fixtures/reports/complete-blood-count-2026-03-02.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('documentId', pm.response.json().id);",
                  "pm.collectionVariables.set('pollsLeft', 30);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait until processed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}",
                "status"
              ]
            },
            "description": "Light-weight status for polling: UPLOADED → PROCESSING → READY or FAILED. In the collection runner this request repeats until the document is ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const { status } = pm.response.json();",
                  "const left = Number(pm.collectionVariables.get('pollsLeft')) - 1;",
                  "pm.collectionVariables.set('pollsLeft', left);",
                  "if ((status === 'UPLOADED' || status === 'PROCESSING') && left > 0) {",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest('Wait until processed');",
                  "} else {",
                  "  pm.test('document is READY', () => pm.expect(status).to.eql('READY'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List documents (timeline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Your documents, newest record date first; undated last. size ≤ 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
