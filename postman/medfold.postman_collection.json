        },
        {
          "name": "Extracted results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/results",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}",
                "results"
              ]
            },
            "description": "Lab results (as printed, plus the backend's comparison with the printed range), medicines and explained terms."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('has lab results', () => pm.expect(r.labResults.length).to.be.above(0));",
                  "pm.collectionVariables.set('labResultId', r.labResults[0].id);",
                  "pm.collectionVariables.set('testKey', r.labResults[0].testKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "Download the original file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}",
                "file"
              ]
            },
            "description": "The uploaded file, inline, never cached."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Correct document details",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}"
              ]
            },
            "description": "Fields you leave out are unchanged; an empty string clears one. Corrections survive reprocessing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete Blood Count (March)\",\n  \"providerName\": \"Dr. Meera Iyer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('marked as edited', () => pm.expect(pm.response.json().userEdited).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Process again",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}/reprocess",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}",
                "reprocess"
