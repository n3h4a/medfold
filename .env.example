# Copy this file to .env and change the values for your machine.
# .env is git-ignored; never commit real secrets.

# PostgreSQL
POSTGRES_DB=medfold
POSTGRES_USER=medfold
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Backend (Spring Boot)
BACKEND_PORT=8080

# AI service (FastAPI)
AI_SERVICE_PORT=8000
# Shared secret between backend and AI service. Generate one with: openssl rand -hex 32
AI_INTERNAL_KEY=change_me_to_a_long_random_string
OCR_PROVIDER=tesseract
# LLM API key, used from the extraction tasks onward. Leave empty for now.
LLM_API_KEY=
