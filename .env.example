# Copy this file to .env and change the values for your machine.
# .env is git-ignored; never commit real secrets.

# PostgreSQL
POSTGRES_DB=medfold
POSTGRES_USER=medfold
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Backend (Spring Boot)
BACKEND_PORT=8080
# Signs login tokens. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
# Local development over plain HTTP only. Leave unset (true) in production.
REFRESH_COOKIE_SECURE=false
# Folder for uploaded files, relative to backend/ (default ../data/uploads)
STORAGE_ROOT=../data/uploads

# AI service (FastAPI)
AI_SERVICE_PORT=8000
# Shared secret between backend and AI service. Generate one with: openssl rand -hex 32
AI_INTERNAL_KEY=change_me_to_a_long_random_string
OCR_PROVIDER=tesseract
# LLM API key, used from the extraction tasks onward. Leave empty for now.
LLM_API_KEY=
